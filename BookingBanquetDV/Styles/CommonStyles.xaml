<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:x1="using:System">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="TitleBarBackGround" Color="#283145" />
    <SolidColorBrush x:Key="AppLoginBackGround" Color="#F0F0F0" />
    <SolidColorBrush x:Key="NavigationPaneBackgroundBrush" Color="#393939" />
    <SolidColorBrush x:Key="NotesControlBorderColor" Color="#FF7A7A7A" />
    <x:Double x:Key="MinWindowSnapPoint">0</x:Double>
    <x:Double x:Key="MediumWindowSnapPoint">641</x:Double>
    <x:Double x:Key="LargeWindowSnapPoint">1008</x:Double>
    <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        Margin="0"
                        Padding="0"
                        Foreground="White"
                        Text="{Binding}"
                        Visibility="{Binding Converter={StaticResource TextToHeaderVisibilityConverter}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style
        x:Key="HighlightTextBoxStyle"
        BasedOn="{StaticResource BaseTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="BorderBrush" Value="Red" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        Margin="0"
                        Padding="0"
                        Foreground="Red"
                        Text="{Binding}"
                        Visibility="{Binding Converter={StaticResource TextToHeaderVisibilityConverter}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TextBlockFontStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="segoe ui" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="ErrorMessageStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="Red" />
        <Setter Property="Margin" Value="50,0,0,0" />
        <Setter Property="FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
    </Style>
    <Style x:Key="LineStyle" TargetType="Line">
        <Setter Property="Stroke" Value="#D2D2D2" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="X1" Value="0" />
        <Setter Property="X2" Value="2500" />
    </Style>
    <Style x:Key="BaseComboBoxStyle" TargetType="ComboBox">
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style
        x:Key="HighlightComboBoxStyle"
        BasedOn="{StaticResource BaseComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="BorderBrush" Value="Red" />
    </Style>
    <Style x:Key="NoHistoryBorder" TargetType="Border">
        <Setter Property="Height" Value="35" />
    </Style>
    <Style
        x:Key="NoHistoryMessageStyle"
        BasedOn="{StaticResource TextBlockFontStyle}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource InactiveResouceGridTextBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="MainHeaderLine" TargetType="Line">
        <Setter Property="Stroke" Value="BlueViolet" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="X1" Value="0" />
        <Setter Property="X2" Value="2500" />
    </Style>
    <Style x:Key="UserDetailMainGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="10,10,10,15" />
    </Style>
</ResourceDictionary>
