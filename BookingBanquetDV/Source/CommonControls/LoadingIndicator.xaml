<UserControl
    x:Class="BookingBanquetDV.Source.CommonControls.LoadingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Emis.Mobile.Client.Source.CommonControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="loadingControl">
        <Grid.Background>
            <SolidColorBrush Opacity=".4" Color="Black" />
        </Grid.Background>
        <StackPanel
            Padding="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#424242"
            CornerRadius="5"
            Opacity=".8"
            Orientation="Horizontal">
            <ProgressRing
                Margin="0,0,12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                IsActive="True" />
            <TextBlock
                x:Name="loadingText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                Text="Loading..." />
        </StackPanel>
    </Grid>
</UserControl>
