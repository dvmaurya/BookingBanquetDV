<Page
    x:Class="BookingBanquetDV.Source.Welcome.PrintOut.PageToPrint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:welcome="using:BookingBanquetDV.Source.Welcome"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid x:Name="PrintableArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <StackPanel
            x:Name="Header"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <RichTextBlock x:Name="Address" Grid.Column="0">
                    <Paragraph FontSize="32">Banquet Address</Paragraph>
                    <Paragraph>Village + Post: Muhammadalla</Paragraph>
                    <Paragraph>Azamgarh, UP</Paragraph>
                    <Paragraph>276001</Paragraph>
                </RichTextBlock>
                <RichTextBlock
                    x:Name="Contact"
                    Grid.Column="1"
                    HorizontalAlignment="Right">
                    <Paragraph FontSize="32">Durgvijay Maurya</Paragraph>
                    <Paragraph>dvmaurya6@gmail.com</Paragraph>
                    <Paragraph>9455687773</Paragraph>
                </RichTextBlock>
            </Grid>
        </StackPanel>
        <RichTextBlock
            x:Name="TextSelection"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="Segoe UI"
            FontSize="18"
            Foreground="Black"
            IsTextSelectionEnabled="True"
            OverflowContentTarget="{Binding ElementName=FirstLinkedContainer}"
            TextAlignment="Left"
            Visibility="Collapsed" />
        <RichTextBlock
            x:Name="TextContent"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="Segoe UI"
            FontSize="18"
            Foreground="Black"
            IsTextSelectionEnabled="True"
            OverflowContentTarget="{Binding ElementName=FirstLinkedContainer}"
            TextAlignment="Left">
            <Paragraph>
                <InlineUIContainer>
                    <welcome:ViewBooking />
                </InlineUIContainer>
            </Paragraph>
        </RichTextBlock>
        <RichTextBlockOverflow
            x:Name="FirstLinkedContainer"
            Grid.Row="2"
            Grid.Column="0"
            OverflowContentTarget="{Binding ElementName=ContinuationPageLinkedContainer}" />
        <RichTextBlockOverflow
            x:Name="ContinuationPageLinkedContainer"
            Grid.Row="3"
            Grid.ColumnSpan="2" />
        <StackPanel
            x:Name="Footer"
            Grid.Row="4"
            Grid.ColumnSpan="2">
            <TextBlock
                FontFamily="Segoe UI"
                FontSize="16"
                Foreground="Black"
                TextAlignment="Left">
                Copyright © Durgvijay Corporation. All rights reserved.
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
