<ContentDialog
    x:Class="BookingBanquetDV.Source.Welcome.Controls.AllProfilePhoto"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Choose profile pic"
    Width="800"
    Loading="ContentDialog_Loading"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Done"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    SecondaryButtonText="Cancel"
    mc:Ignorable="d">
    <Grid Margin="0,10,0,0">
        <ListView
            Name="MultiselectlistView"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            ItemsSource="{Binding PhotoDetailList, Mode=TwoWay}"
            SelectionMode="None">
            <ListView.Header>
                <Border Margin="20,20,0,0" Visibility="{Binding PhotoDetailList.Count, Converter={StaticResource VisibleWhenZeroConverter}}">
                    <TextBlock Text="No photo(s) available" />
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="-12,0,-12,0">
                        <RadioButton
                            Command="{Binding DataContext.ChangePhotoCommand, ElementName=MultiselectlistView}"
                            CommandParameter="{Binding}"
                            GroupName="Photo"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            Visibility="{Binding IsPhotoRemoved, Converter={StaticResource NotBooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="0,0,20,0"
                                    Text="Photo not available"
                                    Visibility="{Binding ImageSource, Converter={StaticResource VisibleWhenNullConverter}}" />
                                <Image
                                    Grid.Row="0"
                                    Margin="10,0,10,10"
                                    Source="{Binding ImageSource}"
                                    Visibility="{Binding ImageSource, Converter={StaticResource VisibleWhenNotNullConverter}}" />
                                <Grid Grid.Row="1" Margin="10,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        TextWrapping="Wrap">
                                        <Run Text="Captured on:" />
                                        <Run Text="{Binding Date}" />
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                        <Run Text="Size:" />
                                        <Run Text="{Binding Size, Converter={StaticResource ByteToMegabyteVisibilityConverter}}" />
                                    </TextBlock>
                                    <Button
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="AliceBlue"
                                        Command="{Binding DataContext.DeletePhotoCommand, ElementName=MultiselectlistView}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsChecked}">
                                        <ToolTipService.ToolTip>
                                            <TextBlock Text="Permanentaly delete photo" />
                                        </ToolTipService.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Remove forever" />
                                            <FontIcon
                                                Margin="10,0,0,0"
                                                Foreground="Red"
                                                Glyph="&#xE74D;" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Line
                                    Grid.Row="2"
                                    Margin="10,10,0,10"
                                    Stroke="LightGray"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="540"
                                    Y1="0"
                                    Y2="0" />
                            </Grid>
                        </RadioButton>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>