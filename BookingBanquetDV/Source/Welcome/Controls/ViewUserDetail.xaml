<ContentDialog
    x:Class="BookingBanquetDV.Source.Welcome.Controls.ViewUserDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="User's detail"
    Loading="ContentDialog_Loading"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Close"
    mc:Ignorable="d">
    <ScrollViewer x:Name="rootScrollViewer" VerticalScrollBarVisibility="Auto">
        <Grid VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="11" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Line
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,10"
                Stroke="LightGray"
                StrokeThickness="1"
                X1="0"
                X2="540"
                Y1="0"
                Y2="0" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Full name" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding UsersPersonalDetail.FullName}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,10,0,10"
                Stroke="LightGray"
                StrokeThickness="1"
                X1="0"
                X2="540"
                Y1="0"
                Y2="0" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Text="Email id" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="1"
                Text="{Binding UsersPersonalDetail.EmailId}" />
            <Line
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,10,0,10"
                Stroke="LightGray"
                StrokeThickness="1"
                X1="0"
                X2="540"
                Y1="0"
                Y2="0" />
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Text="Mobile no" />
            <TextBlock
                Grid.Row="5"
                Grid.Column="1"
                TextWrapping="Wrap">
                <Run Text="{Binding UsersPersonalDetail.PhoneCode}" /><Run Text="{Binding UsersPersonalDetail.Mobile}" />
            </TextBlock>
            <Line
                Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,10,0,10"
                Stroke="LightGray"
                StrokeThickness="1"
                X1="0"
                X2="540"
                Y1="0"
                Y2="0" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="0"
                Text="Address" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="1"
                TextWrapping="Wrap">
                <Run Text="{Binding UsersPersonalDetail.Address}" /><Run Text="," />
                <Run Text="{Binding UsersPersonalDetail.Country}" /><Run Text="," />
                <Run Text="{Binding UsersPersonalDetail.State}" /><Run Text="," />
                <Run Text="{Binding UsersPersonalDetail.City}" />
            </TextBlock>
            <Line
                Grid.Row="8"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,10,0,10"
                Stroke="LightGray"
                StrokeThickness="1"
                X1="0"
                X2="540"
                Y1="0"
                Y2="0" />
            <StackPanel
                Grid.Row="9"
                Grid.Column="0"
                Grid.ColumnSpan="2">
                <TextBlock Text="Profile photo" />
                <Grid>
                    <Image
                        x:Name="previewImage"
                        Height="400"
                        Margin="0,10,0,0"
                        Source="{Binding UsersPersonalDetail.ImageSource}"
                        Stretch="Fill"
                        Visibility="{Binding UsersPersonalDetail.ImageSource, Converter={StaticResource VisibleWhenNotNullConverter}}" />
                    <TextBlock
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="LightGray"
                        Text="Photo not available"
                        Visibility="{Binding UsersPersonalDetail.ImageSource, Converter={StaticResource VisibleWhenNullConverter}}" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>