<ContentDialog
    x:Class="BookingBanquetDV.Source.Welcome.Controls.ViewBooking"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="View booking details"
    Loading="ContentDialog_Loading"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="CLose"
    mc:Ignorable="d">
    <ScrollViewer x:Name="rootScrollViewer" VerticalScrollBarVisibility="Auto">
        <Grid
            Padding="5"
            VerticalAlignment="Top"
            BorderBrush="Gray"
            BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="11" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Line
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Customer name:" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding BookingDetails.CustomerName}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Text="Booked by:" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="1"
                Text="{Binding BookingDetails.BookedBy}" />
            <Line
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Text="Customer's mobile no:" />
            <TextBlock
                Grid.Row="5"
                Grid.Column="1"
                Text="{Binding BookingDetails.MobileNo}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="0"
                Text="Customer's email id:" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="1"
                Text="{Binding BookingDetails.EmailId}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="8"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="9"
                Grid.Column="0"
                Text="Customer address" />
            <StackPanel
                Grid.Row="9"
                Grid.Column="1"
                Orientation="Horizontal">
                <TextBlock Text="{Binding BookingDetails.Address}" Visibility="{Binding BookingDetails.Address, Converter={StaticResource VisibleWhenNotEmptyStringConverter}}" />
                <TextBlock
                    Margin="2,0,0,0"
                    Text="{Binding BookingDetails.Country}"
                    Visibility="{Binding BookingDetails.Country, Converter={StaticResource VisibleWhenNotEmptyStringConverter}}" />
                <TextBlock
                    Margin="2,0,0,0"
                    Text="{Binding BookingDetails.State}"
                    Visibility="{Binding BookingDetails.State, Converter={StaticResource VisibleWhenNotEmptyStringConverter}}" />
                <TextBlock
                    Margin="2,0,0,0"
                    Text="{Binding BookingDetails.City}"
                    Visibility="{Binding BookingDetails.City, Converter={StaticResource VisibleWhenNotEmptyStringConverter}}" />
            </StackPanel>
            <Line
                Grid.Row="10"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="11"
                Grid.Column="0"
                Text="Booking date:" />
            <TextBlock
                Grid.Row="11"
                Grid.Column="1"
                Text="{Binding BookingDetails.BookingDate}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="12"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="13"
                Grid.Column="0"
                Text="Tootal room booked:" />
            <TextBlock
                Grid.Row="13"
                Grid.Column="1"
                Text="{Binding BookingDetails.TotalRooms}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="14"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="15"
                Grid.Column="0"
                Text="Tootal flour booked:" />
            <TextBlock
                Grid.Row="15"
                Grid.Column="1"
                Text="{Binding BookingDetails.TotalFlours}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="16"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="17"
                Grid.Column="0"
                Text="Tootal amount:" />
            <TextBlock
                Grid.Row="17"
                Grid.Column="1"
                Text="{Binding BookingDetails.TotalAmount}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="18"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="19"
                Grid.Column="0"
                Text="Advance amount:" />
            <TextBlock
                Grid.Row="19"
                Grid.Column="1"
                Text="{Binding BookingDetails.Advanced}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="20"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="21"
                Grid.Column="0"
                Text="Remaining amount:" />
            <TextBlock
                Grid.Row="21"
                Grid.Column="1"
                Text="{Binding BookingDetails.Balance}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="22"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="23"
                Grid.Column="0"
                Text="Booking confirmation:" />
            <TextBlock
                Grid.Row="23"
                Grid.Column="1"
                Text="{Binding BookingDetails.Confirmation}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="24"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <TextBlock
                Grid.Row="25"
                Grid.Column="0"
                Text="When booked:" />
            <TextBlock
                Grid.Row="25"
                Grid.Column="1"
                Text="{Binding BookingDetails.CreationDate}"
                TextWrapping="Wrap" />
            <Line
                Grid.Row="26"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource ViewBookingLine}" />
            <StackPanel
                Grid.Row="27"
                Grid.Column="0"
                Grid.ColumnSpan="2">
                <TextBlock Text="Customer's photo" />
                <Grid>
                    <Image
                        x:Name="previewImage"
                        Height="400"
                        Margin="0,10,0,10"
                        Source="{Binding ImageSource}"
                        Stretch="Fill"
                        Visibility="{Binding ImageSource, Converter={StaticResource VisibleWhenNotNullConverter}}" />
                    <TextBlock
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="LightGray"
                        Text="Photo not available"
                        Visibility="{Binding ImageSource, Converter={StaticResource VisibleWhenNullConverter}}" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
