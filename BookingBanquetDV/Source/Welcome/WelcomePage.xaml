<Page
    x:Class="BookingBanquetDV.Source.Welcome.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid Background="AliceBlue">
        <Grid
            Margin="10,20"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid Margin="20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button
                            Background="#2596BE"
                            Command="{Binding NewBookingCommand}"
                            Content="Add New Booking"
                            Foreground="#FFFFFF"
                            PointerEntered="AppBarButton_PointerEntered"
                            PointerExited="AppBarButton_PointerExited" />
                        <Button
                            Margin="10,0,0,0"
                            Background="#2596BE"
                            Command="{Binding BanquetConfigCommand}"
                            Content="Banquet configuration"
                            Foreground="#FFFFFF"
                            PointerEntered="AppBarButton_PointerEntered"
                            PointerExited="AppBarButton_PointerExited" />
                    </StackPanel>
                    <Grid Grid.Row="0" HorizontalAlignment="Right">
                        <Button
                            Margin="0,0,10,10"
                            BorderBrush="Green"
                            BorderThickness="1"
                            PointerEntered="AppBarButton_PointerEntered"
                            PointerExited="AppBarButton_PointerExited">
                            <ToolTipService.ToolTip>
                                <TextBlock Text="{Binding UsersPersonalDetail.FullName}" />
                            </ToolTipService.ToolTip>
                            <Grid>
                                <Image Source="{Binding UsersPersonalDetail.ImageSource}" Visibility="{Binding UsersPersonalDetail.ImageSource, Converter={StaticResource VisibleWhenNotNullConverter}}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding UsersPersonalDetail.FullName}"
                                    Visibility="{Binding UsersPersonalDetail.ImageSource, Converter={StaticResource VisibleWhenNullConverter}}" />
                            </Grid>
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem>
                                        <MenuFlyoutItem.Template>
                                            <ControlTemplate TargetType="MenuFlyoutItem">
                                                <StackPanel Width="170" Margin="10">
                                                    <TextBlock Text="{Binding UsersPersonalDetail.FullName}" TextWrapping="Wrap" />
                                                    <Line
                                                        Margin="0,10,0,3"
                                                        Stroke="Gray"
                                                        StrokeThickness="1"
                                                        X1="0"
                                                        X2="300"
                                                        Y1="0"
                                                        Y2="0" />
                                                    <HyperlinkButton Command="{Binding ViewProfileCommand}" Content="View profile" />
                                                    <Line
                                                        Margin="0,10,0,3"
                                                        Stroke="Gray"
                                                        StrokeThickness="1"
                                                        X1="0"
                                                        X2="300"
                                                        Y1="0"
                                                        Y2="0" />
                                                    <HyperlinkButton Command="{Binding EditProfileCommand}" Content="Edit profile" />
                                                    <Line
                                                        Margin="0,10,0,3"
                                                        Stroke="Gray"
                                                        StrokeThickness="1"
                                                        X1="0"
                                                        X2="300"
                                                        Y1="0"
                                                        Y2="0" />
                                                    <HyperlinkButton Command="{Binding SendUserEmailCommand}" Content="Send details to user's mail" />
                                                    <Line
                                                        Margin="0,10,0,3"
                                                        Stroke="Gray"
                                                        StrokeThickness="1"
                                                        X1="0"
                                                        X2="300"
                                                        Y1="0"
                                                        Y2="0" />
                                                    <HyperlinkButton Command="{Binding ChangePasswordCommand}" Content="Change password" />
                                                    <Line
                                                        Margin="0,10,0,3"
                                                        Stroke="Gray"
                                                        StrokeThickness="1"
                                                        X1="0"
                                                        X2="300"
                                                        Y1="0"
                                                        Y2="0" />
                                                    <HyperlinkButton Command="{Binding LogoutCommand}" Content="Logout" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </MenuFlyoutItem.Template>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Line
                        Grid.Row="1"
                        Stroke="Black"
                        StrokeThickness="1"
                        X1="0"
                        X2="2500"
                        Y1="0"
                        Y2="0" />
                </Grid>
                <Border
                    x:Name="NoAppData"
                    Grid.Row="1"
                    Style="{StaticResource NoHistoryBorder}"
                    Visibility="{Binding BookingDetailList.Count, Mode=OneWay, Converter={StaticResource VisibleWhenZeroConverter}}">
                    <TextBlock Style="{StaticResource NoHistoryMessageStyle}">
                        <Run Text="No records available" /></TextBlock>
                </Border>
                <ScrollViewer Grid.Row="1" Visibility="{Binding BookingDetailList.Count, Mode=OneWay, Converter={StaticResource VisibleWhenNonzeroConverter}}">
                    <StackPanel>
                        <Grid
                            Height="50"
                            Margin="0,5,0,5"
                            BorderBrush="Gray"
                            BorderThickness="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Customer's Name"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Booked by"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="2"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Booking for date"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="3"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Total rooms / flours"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="4"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Total amount"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="5"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Advance amount"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="6"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Balance amount"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="7"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Customer's Mobile"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="8"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Customer's EmailId"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="9"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="When booked"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="10"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Customer's photo"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Column="11">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Action"
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                        <ItemsControl
                            x:Name="BookingList"
                            Margin="0,-5,0,0"
                            ItemsSource="{Binding BookingDetailList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid BorderBrush="Gray" BorderThickness="2,0,2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.Column="0"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding CustomerName}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                        <Border
                                            Grid.Column="1"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <HyperlinkButton
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ViewProfileCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding BookedBy}" />
                                        </Border>
                                        <Border
                                            Grid.Column="2"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding BookingDate}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="3"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TotalRooms}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="/"
                                                    Visibility="{Binding TotalRooms, Converter={StaticResource VisibleWhenNotEmptyStringConverter}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding TotalFlours}" />
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="4"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding TotalAmount}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="5"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding Advanced}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="6"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding Balance}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="7"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding MobileNo}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="8"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding EmailId}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="9"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding CreationDate}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Grid
                                            Grid.Column="10"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <HyperlinkButton
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.CameraClickCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}"
                                                Content="Add photo"
                                                Visibility="{Binding CanShowPhoto, Converter={StaticResource InverseBooleanConverter}}" />
                                            <HyperlinkButton
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ViewPhotoClickCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}"
                                                Content="View photo"
                                                Visibility="{Binding CanShowPhoto}" />
                                        </Grid>
                                        <CommandBar
                                            x:Name="mainCommandBar"
                                            Grid.Column="11"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center"
                                            PointerEntered="AppBarButton_PointerEntered"
                                            PointerExited="AppBarButton_PointerExited">
                                            <CommandBar.SecondaryCommands>
                                                <AppBarButton
                                                    Command="{Binding DataContext.ViewBookingCommand, ElementName=BookingList}"
                                                    CommandParameter="{Binding}"
                                                    Label="View booking"
                                                    PointerEntered="AppBarButton_PointerEntered"
                                                    PointerExited="AppBarButton_PointerExited" />
                                                <AppBarButton
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.EditBookingCommand, ElementName=BookingList}"
                                                    CommandParameter="{Binding}"
                                                    Label="Edit booking"
                                                    PointerEntered="AppBarButton_PointerEntered"
                                                    PointerExited="AppBarButton_PointerExited" />
                                                <AppBarButton
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteBookingCommand, ElementName=BookingList}"
                                                    CommandParameter="{Binding}"
                                                    Label="Delete booking"
                                                    PointerEntered="AppBarButton_PointerEntered"
                                                    PointerExited="AppBarButton_PointerExited" />
                                                <AppBarButton
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.SendEmailCommand, ElementName=BookingList}"
                                                    CommandParameter="{Binding}"
                                                    Label="Send an email"
                                                    PointerEntered="AppBarButton_PointerEntered"
                                                    PointerExited="AppBarButton_PointerExited" />
                                                <AppBarButton
                                                    Name="InvokePrintingButton"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.PrintOutCommand, ElementName=BookingList}"
                                                    CommandParameter="{Binding}"
                                                    Label="Take a printout"
                                                    PointerEntered="AppBarButton_PointerEntered"
                                                    PointerExited="AppBarButton_PointerExited" />
                                            </CommandBar.SecondaryCommands>
                                        </CommandBar>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
