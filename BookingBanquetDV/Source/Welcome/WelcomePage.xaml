<Page
    x:Class="BookingBanquetDV.Source.Welcome.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid Background="AliceBlue">
        <Grid
            Margin="10,20"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid Margin="20,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button
                        VerticalAlignment="Top"
                        Background="#2596BE"
                        Command="{Binding NewBookingCommand}"
                        Content="Add New Booking"
                        Foreground="#FFFFFF" />
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#2596BE"
                        Command="{Binding LogoutCommand}"
                        Content="Logout"
                        Foreground="#FFFFFF" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <Grid
                            Height="50"
                            Margin="0,5,0,5"
                            BorderBrush="Gray"
                            BorderThickness="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Customer's Name" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Booked by" />
                            </Border>
                            <Border
                                Grid.Column="2"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Booking for date"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="3"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Total rooms / flours"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="4"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Total amount"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="5"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Advance amount"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="6"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Balance amount"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="7"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Confirmation"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="8"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="When booked"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border
                                Grid.Column="9"
                                BorderBrush="Gray"
                                BorderThickness="0,0,2,0">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Customer's photo"
                                    TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Column="10">
                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Action"
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                        <ItemsControl
                            x:Name="BookingList"
                            Margin="0,-5,0,0"
                            ItemsSource="{Binding BookingDetailList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid BorderBrush="Gray" BorderThickness="2,0,2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.Column="0"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding CustomerName}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                        <Border
                                            Grid.Column="1"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding BookedBy}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="2"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding BookingDate}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="3"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextWrapping="Wrap">
                                                <Run Text="{Binding NumberOfRooms}" /><Run Text="/" /><Run Text="{Binding NumberOfFlours}" /></TextBlock>
                                        </Border>
                                        <Border
                                            Grid.Column="4"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding TotalAmount}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="5"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding Advanced}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="6"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding Balance}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="7"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding Confirmation}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Border
                                            Grid.Column="8"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding CreationDate}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Grid
                                            Grid.Column="9"
                                            BorderBrush="Gray"
                                            BorderThickness="0,0,2,0">
                                            <HyperlinkButton
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.CameraClickCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}"
                                                Content="Add photo"
                                                Visibility="{Binding CanShowPhoto, Converter={StaticResource InverseBooleanConverter}}" />
                                            <HyperlinkButton
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ViewPhotoClickCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}"
                                                Content="View photo"
                                                Visibility="{Binding CanShowPhoto}" />
                                        </Grid>
                                        <Grid Grid.Column="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Column="0"
                                                Height="40"
                                                Background="AliceBlue"
                                                Command="{Binding DataContext.ViewBookingCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock Text="View booking" />
                                                </ToolTipService.ToolTip>
                                                <Grid>
                                                    <FontIcon
                                                        Height="40"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Glyph="&#xE91F;"
                                                        Opacity=".7" />
                                                    <Image
                                                        Width="16"
                                                        Height="16"
                                                        Source="ms-appx:///Assets/EYE_UWP.png" />
                                                </Grid>
                                            </Button>
                                            <Button
                                                Grid.Column="1"
                                                Height="40"
                                                Background="AliceBlue"
                                                Command="{Binding DataContext.EditBookingCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock Text="Edit booking" />
                                                </ToolTipService.ToolTip>
                                                <FontIcon Foreground="#000000" Glyph="&#xE70F;" />
                                            </Button>
                                            <Button
                                                Grid.Column="2"
                                                Height="40"
                                                Background="AliceBlue"
                                                Command="{Binding DataContext.DeleteBookingCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock Text="Delete booking" />
                                                </ToolTipService.ToolTip>
                                                <FontIcon Foreground="Red" Glyph="&#xE74D;" />
                                            </Button>
                                            <!--<HyperlinkButton
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ViewBookingCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}"
                                                Content="View" />-->
                                            <!--<HyperlinkButton
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.UpdateBookingCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}"
                                                Content="Update" />
                                            <HyperlinkButton
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteBookingCommand, ElementName=BookingList}"
                                                CommandParameter="{Binding}"
                                                Content="delete" />-->
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
