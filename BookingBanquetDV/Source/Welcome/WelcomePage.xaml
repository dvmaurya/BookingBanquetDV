<Page
    x:Class="BookingBanquetDV.Source.Welcome.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BookingBanquetDV.Source"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid Background="AliceBlue">
        <Grid
            Margin="10,20"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid Margin="20,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button
                        VerticalAlignment="Top"
                        Background="#2596BE"
                        Command="{Binding NewBookingCommand}"
                        Content="Add New Booking"
                        Foreground="#FFFFFF" />
                </Grid>
                <StackPanel Grid.Row="1">
                    <Grid
                        Height="50"
                        Margin="0,5,0,5"
                        BorderBrush="Gray"
                        BorderThickness="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Customer's Name" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Booked by" />
                        </Border>
                        <Border
                            Grid.Column="2"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Booking for date"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border
                            Grid.Column="3"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Number of rooms / flours"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border
                            Grid.Column="4"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Total amount"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border
                            Grid.Column="5"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Advance amount"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border
                            Grid.Column="6"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Balance amount"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border
                            Grid.Column="7"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Confirmation"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border
                            Grid.Column="8"
                            BorderBrush="Gray"
                            BorderThickness="0,0,2,0">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="When booked"
                                TextWrapping="Wrap" />
                        </Border>
                        <Border Grid.Column="9">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Customer's photo"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <ItemsControl
                        x:Name="BookingList"
                        Margin="0,-5,0,0"
                        ItemsSource="{Binding BookingDetailList, Mode=TwoWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid BorderBrush="Gray" BorderThickness="2,0,2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding CustomerName}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding BookedBy}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding BookingDate}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border
                                        Grid.Column="3"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap">
                                            <Run Text="{Binding NumberOfRooms}" /><Run Text="/" /><Run Text="{Binding NumberOfFlours}" />
                                        </TextBlock>
                                    </Border>
                                    <Border
                                        Grid.Column="4"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding TotalAmount}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border
                                        Grid.Column="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding Advanced}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border
                                        Grid.Column="6"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding Balance}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border
                                        Grid.Column="7"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding Confirmation}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Border
                                        Grid.Column="8"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,2,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding BookingDate}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <HyperlinkButton
                                        Grid.Column="9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.CameraViewModel.CameraClickCommand, ElementName=BookingList}"
                                        Content="Add photo" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
