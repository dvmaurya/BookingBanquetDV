<ContentDialog
    x:Class="BookingBanquetDV.Source.Welcome.NewBooking"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BookingBanquetDV.Behavior"
    xmlns:commoncontrols="using:BookingBanquetDV.Utility"
    xmlns:controls1="using:BookingBanquetDV.Source.Register"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="BookingDialog"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    BorderBrush="Green"
    BorderThickness="10"
    Loading="ContentDialog_Loading"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Submit"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    SecondaryButtonText="Close"
    mc:Ignorable="d">
    <ScrollViewer x:Name="rootScrollViewer" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="375" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="120" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
                <RowDefinition Height="65" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="Red"
                    Text="*"
                    Visibility="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Customer's name:"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,10,0">
                <TextBox
                    IsReadOnly="{Binding BookingParameter.IsViewBooking}"
                    MaxLength="50"
                    PlaceholderText="Enter customer name"
                    Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[CustomerName]}" />
                    </interactivity:Interaction.Behaviors>
                </TextBox>
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[CustomerName], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="Red"
                    Text="*"
                    Visibility="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Customer's Mobile:"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,10,0">
                <TextBox
                    InputScope="Number"
                    IsReadOnly="{Binding BookingParameter.IsViewBooking}"
                    MaxLength="10"
                    PlaceholderText="Mobile number"
                    Text="{Binding MobileNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:NumericTextBoxBehavior AllowDecimal="True" />
                        <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[MobileNo]}" />
                    </interactivity:Interaction.Behaviors>
                </TextBox>
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[MobileNo], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="Red"
                    Text="*"
                    Visibility="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Customer's EmailId:"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,10,0">
                <TextBox
                    Grid.Column="1"
                    IsReadOnly="{Binding BookingParameter.IsViewBooking}"
                    PlaceholderText="Email id"
                    Text="{Binding EmailId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[EmailId]}" />
                    </interactivity:Interaction.Behaviors>
                </TextBox>
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[EmailId], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="3" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="Red"
                    Text="*"
                    Visibility="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Address:"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel Grid.Row="3" Grid.Column="1">
                <controls1:NotesControl
                    x:Name="NotesText"
                    Grid.Column="1"
                    IsEnabled="{Binding IsOtpEnable, Converter={StaticResource InverseBooleanConverter}}"
                    NotesText="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Enter address" />
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[Address], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="4" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="Red"
                    Text="*"
                    Visibility="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Country:"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel Grid.Row="4" Grid.Column="1">
                <commoncontrols:ComboBoxExt
                    Width="368"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding IsOtpEnable, Converter={StaticResource InverseBooleanConverter}}"
                    ItemsSource="{Binding CountryList}"
                    PlaceholderText="Country"
                    SelectedItem="{Binding SelectedCountry, Mode=TwoWay}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:HighlightFormFieldOnErrors
                            HighlightStyleName="HighlightComboBoxStyle"
                            OriginalStyleName="BaseComboBoxStyle"
                            PropertyErrors="{Binding Errors[SelectedCountry]}" />
                        <core:EventTriggerBehavior EventName="SelectionChanged">
                            <core:EventTriggerBehavior.Actions>
                                <core:InvokeCommandAction Command="{Binding ChangedCountryCommand}" CommandParameter="{Binding SelectedCountry}" />
                            </core:EventTriggerBehavior.Actions>
                        </core:EventTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                </commoncontrols:ComboBoxExt>
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[SelectedCountry], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Text="State:"
                TextWrapping="Wrap" />
            <StackPanel Grid.Row="5" Grid.Column="1">
                <commoncontrols:ComboBoxExt
                    Width="368"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding IsOtpEnable, Converter={StaticResource InverseBooleanConverter}}"
                    ItemsSource="{Binding CountryList}"
                    PlaceholderText="Country"
                    SelectedItem="{Binding SelectedCountry, Mode=TwoWay}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:HighlightFormFieldOnErrors
                            HighlightStyleName="HighlightComboBoxStyle"
                            OriginalStyleName="BaseComboBoxStyle"
                            PropertyErrors="{Binding Errors[SelectedCountry]}" />
                        <core:EventTriggerBehavior EventName="SelectionChanged">
                            <core:EventTriggerBehavior.Actions>
                                <core:InvokeCommandAction Command="{Binding ChangedCountryCommand}" CommandParameter="{Binding SelectedCountry}" />
                            </core:EventTriggerBehavior.Actions>
                        </core:EventTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                </commoncontrols:ComboBoxExt>
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[SelectedCountry], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                Text="City:"
                TextWrapping="Wrap" />
            <StackPanel Grid.Row="6" Grid.Column="1">
                <commoncontrols:ComboBoxExt
                    Width="368"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding IsOtpEnable, Converter={StaticResource InverseBooleanConverter}}"
                    ItemsSource="{Binding CountryList}"
                    PlaceholderText="Country"
                    SelectedItem="{Binding SelectedCountry, Mode=TwoWay}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:HighlightFormFieldOnErrors
                            HighlightStyleName="HighlightComboBoxStyle"
                            OriginalStyleName="BaseComboBoxStyle"
                            PropertyErrors="{Binding Errors[SelectedCountry]}" />
                        <core:EventTriggerBehavior EventName="SelectionChanged">
                            <core:EventTriggerBehavior.Actions>
                                <core:InvokeCommandAction Command="{Binding ChangedCountryCommand}" CommandParameter="{Binding SelectedCountry}" />
                            </core:EventTriggerBehavior.Actions>
                        </core:EventTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                </commoncontrols:ComboBoxExt>
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[SelectedCountry], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Grid.Row="7"
                Grid.Column="0"
                Text="Total rooms:"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="7"
                Grid.Column="1"
                Margin="0,0,10,20">
                <TextBox
                    InputScope="Number"
                    IsReadOnly="{Binding BookingParameter.IsViewBooking}"
                    MaxLength="2"
                    PlaceholderText="Number of rooms"
                    Text="{Binding TotalRooms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:NumericTextBoxBehavior AllowDecimal="True" />
                        <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[TotalRooms]}" />
                    </interactivity:Interaction.Behaviors>
                </TextBox>
            </StackPanel>
            <TextBlock
                Grid.Row="8"
                Grid.Column="0"
                Text="Total flours:"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="8"
                Grid.Column="1"
                Margin="0,0,10,20">
                <TextBox
                    InputScope="Number"
                    IsReadOnly="{Binding BookingParameter.IsViewBooking}"
                    MaxLength="1"
                    PlaceholderText="Number of flours"
                    Text="{Binding TotalFlours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:NumericTextBoxBehavior AllowDecimal="True" />
                        <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[TotalFlours]}" />
                    </interactivity:Interaction.Behaviors>
                </TextBox>
            </StackPanel>
            <Grid Grid.Row="9" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="Red"
                    Text="*"
                    Visibility="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Date for  booking:"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                Grid.Row="9"
                Grid.Column="1"
                Margin="0,0,10,0"
                Orientation="Vertical">
                <CalendarDatePicker
                    Name="Date"
                    Grid.Column="0"
                    Width="365"
                    Date="{Binding BookingDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    DateFormat="{}{dayofweek.abbreviated(3)}‎, ‎{day.integer} ‎{month.abbreviated(3)}‎ ‎{year.full}"
                    IsEnabled="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}"
                    MinDate="{Binding MinDateTime, Mode=TwoWay}" />
                <TextBlock
                    x:Name="DateText"
                    Margin="0"
                    Foreground="Red"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[BookingDate], Converter={StaticResource FirstErrorConverter}}" />
            </StackPanel>
            <TextBlock
                Grid.Row="10"
                Grid.Column="0"
                Margin="0,0,0,0"
                Text="Booked by:" />
            <StackPanel
                Grid.Row="10"
                Grid.Column="1"
                Margin="0,0,10,20">
                <TextBox IsReadOnly="True" Text="{Binding BookedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Grid Grid.Row="11" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="Red"
                    Text="*"
                    Visibility="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Total amount:"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                Grid.Row="11"
                Grid.Column="1"
                Margin="0,0,10,0">
                <TextBox
                    x:Name="TotalAmount"
                    InputScope="Number"
                    IsReadOnly="{Binding BookingParameter.IsViewBooking}"
                    KeyUp="TextBox_KeyUp"
                    MaxLength="7"
                    PlaceholderText="Enter total amount"
                    Text="{Binding TotalAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:NumericTextBoxBehavior AllowDecimal="True" />
                        <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[TotalAmount]}" />
                    </interactivity:Interaction.Behaviors>
                </TextBox>
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[TotalAmount], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="12" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="Red"
                    Text="*"
                    Visibility="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    Text="Advance:"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                Grid.Row="12"
                Grid.Column="1"
                Margin="0,0,10,0">
                <TextBox
                    x:Name="Advance"
                    InputScope="Number"
                    IsReadOnly="{Binding BookingParameter.IsViewBooking}"
                    KeyUp="TextBox_KeyUp"
                    MaxLength="7"
                    PlaceholderText="Enter advance amount if any"
                    Text="{Binding Advanced, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:NumericTextBoxBehavior AllowDecimal="True" />
                        <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[Advanced]}" />
                    </interactivity:Interaction.Behaviors>
                </TextBox>
                <TextBlock
                    Margin="0"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text="{Binding Errors[Advanced], Converter={StaticResource FirstErrorConverter}}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                Grid.Row="13"
                Grid.Column="0"
                Text="Remaining amount:"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="13"
                Grid.Column="1"
                Margin="0,0,10,0">
                <TextBox
                    x:Name="RemainingAmount"
                    InputScope="Number"
                    IsReadOnly="True"
                    PlaceholderText="Remaining amount"
                    Text="{Binding Balance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock
                Grid.Row="14"
                Grid.Column="0"
                Margin="0,10,0,0"
                Text="Confirm ?" />
            <StackPanel
                Grid.Row="14"
                Grid.Column="1"
                Margin="0,0,10,20">
                <commoncontrols:ComboBoxExt
                    Width="365"
                    IsEnabled="{Binding BookingParameter.IsViewBooking, Converter={StaticResource InverseBooleanConverter}}"
                    ItemsSource="{Binding ConfirmList}"
                    PlaceholderText="Is booking confirmed ?"
                    SelectedItem="{Binding SelectConfirmation, Mode=TwoWay}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:HighlightFormFieldOnErrors
                            HighlightStyleName="HighlightComboBoxStyle"
                            OriginalStyleName="BaseComboBoxStyle"
                            PropertyErrors="{Binding Errors[SelectConfirmation]}" />
                    </interactivity:Interaction.Behaviors>
                </commoncontrols:ComboBoxExt>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
