<UserControl
    x:Class="BookingBanquetDV.Source.Register.NotesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors1="using:BookingBanquetDV.Behavior"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBox
                Name="addNotes"
                Height="Auto"
                MinWidth="578"
                MinHeight="74"
                MaxWidth="530"
                HorizontalAlignment="Left"
                AcceptsReturn="True"
                GotFocus="ShowNotesLength"
                LostFocus="AddNotes_LostFocus"
                PlaceholderText="{Binding PlaceHolderText, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Text="{Binding NotesText, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap">
                <interactivity:Interaction.Behaviors>
                    <behaviors1:HighlightFormFieldOnErrors PropertyErrors="{Binding Errors[NotesText]}" />
                </interactivity:Interaction.Behaviors>
            </TextBox>
            <TextBlock
                Name="txtNotesLength"
                Margin="0,0,15,0"
                HorizontalAlignment="Right"
                FontSize="14"
                Foreground="Gray">
                <Run Text="{Binding ElementName=addNotes, Path=Text.Length}" />
                <Run Text="/" />
                <Run Text="{Binding MaxLength, ElementName=root}" /></TextBlock>
            <TextBlock
                x:Name="ExceedBlock"
                HorizontalAlignment="Right"
                FontSize="14"
                Foreground="Red"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
