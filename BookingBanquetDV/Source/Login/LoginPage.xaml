<UserControl
    x:Class="BookingBanquetDV.Source.Login.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BookingBanquetDV.Source.Login"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid Background="AliceBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Image
            Grid.Column="1"
            Margin="0,0,50,0"
            Source="ms-appx:///Assets/background.jpg" />
        <Grid
            Grid.Column="0"
            Height="425"
            Margin="50,0,0,0"
            BorderBrush="LightGray"
            BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,50,0,0">
                <TextBlock
                    Margin="50,0,50,10"
                    Foreground="Red"
                    Text="Either username or password is incorrect"
                    Visibility="{Binding IsCredentialWrong, Mode=TwoWay}" />
                <Grid Margin="50,0,50,20">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        BorderBrush="Gray"
                        BorderThickness="2,2,0,2">
                        <Image Height="30" Source="ms-appx:///Assets/username.png" />
                    </Grid>
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        PlaceholderText="Username or email id or mobile number"
                        Text="{Binding UserId, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource ErrorMessageStyle}"
                        Text="{Binding Errors[UserId], Converter={StaticResource FirstErrorConverter}}"
                        TextWrapping="Wrap" />
                </Grid>
                <Grid Margin="50,0,50,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        BorderBrush="Gray"
                        BorderThickness="2,2,0,2">
                        <Image Height="30" Source="ms-appx:///Assets/password.png" />
                    </Grid>
                    <PasswordBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Password="{Binding Password, Mode=TwoWay}"
                        PlaceholderText="Password" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource ErrorMessageStyle}"
                        Text="{Binding Errors[Password], Converter={StaticResource FirstErrorConverter}}"
                        TextWrapping="Wrap" />
                </Grid>
                <CheckBox
                    Margin="50,20,0,0"
                    Content="Remember me"
                    IsChecked="{Binding IsRememberChecked, Mode=TwoWay}" />
                <HyperlinkButton
                    Margin="50,20,0,0"
                    Command="{Binding ForgotPasswordCommand}"
                    Content="Forgot password?" />
            </StackPanel>
            <Grid Grid.Row="1" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="100"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    Background="#2596BE"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Foreground="#FFFFFF" Glyph="&#xE785;" />
                        <TextBlock
                            Margin="5,0,0,0"
                            FontSize="16"
                            Foreground="#FFFFFF"
                            Text="LOGIN" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Width="100"
                    Margin="10,0,0,0"
                    Background="#2596BE"
                    Command="{Binding SignupCommand}"
                    Content="SIGN UP"
                    FontSize="16"
                    Foreground="#FFFFFF" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
