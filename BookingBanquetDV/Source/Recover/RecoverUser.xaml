<Page
    x:Class="BookingBanquetDV.Source.Recover.RecoverUser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BookingBanquetDV.Behavior"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:BookingBanquetDV.Source.Recover"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid Background="AliceBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Image
            Grid.Column="1"
            Margin="0,0,50,0"
            Source="ms-appx:///Assets/background.jpg" />
        <Grid
            Grid.Column="0"
            Margin="50,0,0,50"
            VerticalAlignment="Center"
            BorderBrush="LightGray"
            BorderThickness="1">
            <StackPanel Margin="50,40,0,0">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Recover Password" />
                <StackPanel Margin="0,10,50,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Column="0"
                            Height="32"
                            Margin="0,5,0,0"
                            BorderBrush="Gray"
                            BorderThickness="2,2,0,2">
                            <Image Source="ms-appx:///Assets/email.jpg" />
                        </Grid>
                        <TextBox
                            Grid.Column="1"
                            PlaceholderText="Email id"
                            Text="{Binding EmailId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[EmailId]}" />
                            </interactivity:Interaction.Behaviors>
                        </TextBox>
                    </Grid>
                    <TextBlock
                        Style="{StaticResource ErrorMessageStyle}"
                        Text="{Binding Errors[EmailId], Converter={StaticResource FirstErrorConverter}}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,50,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Column="0"
                            Height="32"
                            Margin="0,5,0,0"
                            BorderBrush="Gray"
                            BorderThickness="2,2,0,2">
                            <Image Source="ms-appx:///Assets/mobileNo.png" />
                        </Grid>
                        <TextBox
                            Grid.Column="1"
                            InputScope="Number"
                            MaxLength="10"
                            PlaceholderText="Mobile number"
                            Text="{Binding MobileNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:NumericTextBoxBehavior AllowDecimal="True" />
                                <behaviors:HighlightFormFieldOnErrors IsHighlightBorderControl="True" PropertyErrors="{Binding Errors[MobileNo]}" />
                            </interactivity:Interaction.Behaviors>
                        </TextBox>
                    </Grid>
                    <TextBlock
                        Style="{StaticResource ErrorMessageStyle}"
                        Text="{Binding Errors[MobileNo], Converter={StaticResource FirstErrorConverter}}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,50,0">
                    <Button
                        Width="100"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        Background="#2596BE"
                        Command="{Binding GetOTPCommand}"
                        Content="Get OTP"
                        FontSize="16"
                        Foreground="#FFFFFF" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Foreground="Green"
                        Text="OTP has been sent to your Mobile number / email id"
                        Visibility="{Binding IsRecoverEnable}" />
                </StackPanel>
                <StackPanel Margin="0,0,50,0" Visibility="{Binding IsRecoverEnable}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="2,2,0,2">
                            <Image Height="30" Source="ms-appx:///Assets/password.png" />
                        </Grid>
                        <PasswordBox
                            Grid.Column="1"
                            Password="{Binding OTP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Enter One Time Password" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource ErrorMessageStyle}"
                        Text="{Binding Errors[OTP], Converter={StaticResource FirstErrorConverter}}"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Background="#2596BE"
                        Command="{Binding RecoverCommand}"
                        Content="Recover password"
                        FontSize="16"
                        Foreground="#FFFFFF" />
                </StackPanel>
                <HyperlinkButton
                    Margin="0,10,50,20"
                    HorizontalAlignment="Center"
                    Command="{Binding LoginCommand}"
                    Content="Click here for login" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
