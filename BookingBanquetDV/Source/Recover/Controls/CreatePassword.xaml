<UserControl
    x:Class="BookingBanquetDV.Source.Recover.Controls.CreatePassword"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BookingBanquetDV.Source.Recover.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <StackPanel Margin="50,40,50,50" VerticalAlignment="Center">
        <StackPanel Margin="0,0,0,20">
            <TextBlock Margin="0,0,0,5" Text="Enter new password" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="2,2,0,2">
                    <Image Height="30" Source="ms-appx:///Assets/password.png" />
                </Grid>
                <PasswordBox
                    Grid.Column="1"
                    Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Password" />
            </Grid>
            <TextBlock
                Style="{StaticResource ErrorMessageStyle}"
                Text="{Binding Errors[Password], Converter={StaticResource FirstErrorConverter}}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Margin="0,0,0,5" Text="Confirm new password" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="2,2,0,2">
                    <Image Height="30" Source="ms-appx:///Assets/password.png" />
                </Grid>
                <PasswordBox
                    Grid.Column="1"
                    Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Confirm password" />
            </Grid>
            <TextBlock
                Style="{StaticResource ErrorMessageStyle}"
                Text="{Binding Errors[ConfirmPassword], Converter={StaticResource FirstErrorConverter}}"
                TextWrapping="Wrap" />
            <Button
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Background="#2596BE"
                Command="{Binding ChangePasswordCommand}"
                Content="Change password"
                FontSize="16"
                Foreground="#FFFFFF" />
            <TextBlock
                Margin="0,20,0,0"
                Style="{StaticResource ErrorMessageStyle}"
                Text="Password update failed"
                Visibility="{Binding PasswordUpdateFailed}" />
        </StackPanel>
    </StackPanel>
</UserControl>
