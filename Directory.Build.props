<Project>
  <PropertyGroup Condition="'$(MSBuildRuntimeType)' == 'Core' and !Exists('$(MSBuildExtensionsPath)\\Microsoft\\WindowsXaml\\v$(VisualStudioVersion)\\Microsoft.Windows.UI.Xaml.CSharp.targets')">
